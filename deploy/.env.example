# Sao thành deploy/.env rồi sửa. KHÔNG commit file .env (đã có trong .gitignore). Quyền: chmod 600 .env
# Tên miền (DuckDNS miễn phí — Q-G): vd tenban.duckdns.org
APP_DOMAIN=tenban.duckdns.org
APP_BASE_URL=https://tenban.duckdns.org

# Múi giờ: Flashscore hiển thị giờ bóng lăn theo múi giờ của trình duyệt crawler (container mặc định UTC)
TZ=Asia/Ho_Chi_Minh

# Đăng ký: approval (tự đăng ký + xác minh email + admin duyệt — Q-B ★) | open | invite
REGISTRATION=approval

# Hạn mức (Q-C ★)
QUOTA_USER_DAILY=10
QUOTA_GLOBAL_HOURLY=30
QUEUE_MAX=20
REFRESH_COOLDOWN_H=6
SESSION_DAYS=14

# Email (để trống SMTP_HOST ⇒ thư chỉ in ra log: docker compose logs web)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Match Performance <no-reply@tenban.duckdns.org>
# Nhận cảnh báo (worker dừng, Flashscore chặn, sao lưu lỗi, canary lỗi)
ADMIN_EMAIL=

# Sao lưu: link "Pre-Authenticated Request" (ghi) của bucket Oracle Object Storage — để trống nếu chưa có
BACKUP_PAR_URL=
BACKUP_KEEP=14
